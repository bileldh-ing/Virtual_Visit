{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=3100 node apps/web/.next/standalone/server.js",
      "startServerReadyPattern": "Ready|started|Listening|localhost",
      "url": ["http://localhost:3100/", "http://localhost:3100/signin", "http://localhost:3100/signup"],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:performance": ["warn", { "minScore": 0.6 }],
        "categories:seo": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
