# Copy to .env and adjust. Every variable maps to services/api/roomscape_api/config.py (prefix ROOMSCAPE_).
ROOMSCAPE_ENV=development                      # development | test | staging | production
ROOMSCAPE_SECRET_KEY=change-me-to-64-random-chars   # signs URLs and unlock tokens; rotate = invalidates links
ROOMSCAPE_DATABASE_URL=postgresql+psycopg://roomscape:roomscape@localhost:5432/roomscape
ROOMSCAPE_REDIS_URL=redis://localhost:6379/0
ROOMSCAPE_PUBLIC_WEB_URL=http://localhost:3000
ROOMSCAPE_CORS_ORIGINS=["http://localhost:3000"]
ROOMSCAPE_COOKIE_SECURE=false                  # true behind HTTPS
ROOMSCAPE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com   # this signup becomes platform admin

# Storage: local disk or any S3-compatible bucket (MinIO, AWS S3, R2)
ROOMSCAPE_STORAGE_BACKEND=s3
ROOMSCAPE_S3_ENDPOINT_URL=http://localhost:9000
ROOMSCAPE_S3_BUCKET=roomscape-private
ROOMSCAPE_S3_ACCESS_KEY=roomscape
ROOMSCAPE_S3_SECRET_KEY=roomscape-dev-secret
ROOMSCAPE_SIGNED_URL_TTL_S=600

# Reconstruction worker
ROOMSCAPE_WORKER_WORKSPACE=./.data/jobs
ROOMSCAPE_COLMAP_THREADS=4
ROOMSCAPE_COLMAP_MAX_IMAGE_SIZE=1600
ROOMSCAPE_JOB_MAX_ATTEMPTS=3

# Reconstruction engines (2.0): auto | marble_world | depth_room | colmap_sparse | panorama_tour
ROOMSCAPE_DEFAULT_ENGINE=auto
# World Labs Marble (paid, optional). Leave empty to run only the free local engines.
# The key is never logged and never returned by the API.
WLT_API_KEY=
ROOMSCAPE_MARBLE_MODEL=marble-1.1
ROOMSCAPE_MARBLE_MODELS_ALLOWED=marble-1.0-draft,marble-1.1
ROOMSCAPE_MARBLE_OPERATION_TIMEOUT_S=1800
# Development/test only: auth | credits — makes every World Labs call fail to exercise the fallback chain
ROOMSCAPE_MARBLE_SIMULATE_FAILURE=
# Free depth fallback (Depth Anything V2 Small ONNX, downloaded at a pinned revision and SHA-256 checked)
ROOMSCAPE_DEPTH_ENGINE_ENABLED=true
ROOMSCAPE_DEPTH_MODEL_PATH=./.data/models/depth-anything-v2-small/model.onnx

# Email (unset = development outbox only, readable at /api/v1/dev/outbox in dev)
ROOMSCAPE_SMTP_URL=
ROOMSCAPE_MAIL_FROM=RoomScape AI <no-reply@example.com>

# Billing: test mode changes plans without payment; stripe mode needs all four
ROOMSCAPE_BILLING_MODE=test
ROOMSCAPE_STRIPE_SECRET_KEY=
ROOMSCAPE_STRIPE_WEBHOOK_SECRET=
ROOMSCAPE_STRIPE_PRICE_PRO=
ROOMSCAPE_STRIPE_PRICE_AGENCY=

# Web (Next.js server-side rewrite target)
ROOMSCAPE_API_INTERNAL_URL=http://localhost:8000
